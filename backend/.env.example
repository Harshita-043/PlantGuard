# Backend settings. Copy this file to .env while working in backend/.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plantguard

# Select explicitly. The application defaults to no storage provider.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local-storage

# Cloudflare R2 S3 API settings. Required only with OBJECT_STORAGE_PROVIDER=r2.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase Storage S3 API settings. Required only with OBJECT_STORAGE_PROVIDER=supabase.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

# Authentication: generate a unique random secret for backend/.env.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional provider settings. Agentic API requests are currently disabled.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434

# Model inference (install backend/requirements-ml.txt in a separate ML environment).
PLANTGUARD_DEVICE=auto
PLANTGUARD_INFERENCE_TIMEOUT_SECONDS=120
PLANTGUARD_MAX_CANDIDATES=8
PLANTGUARD_SAM_STRATEGY=auto
PLANTGUARD_SAM_CONFIG=configs/sam2.1/sam2.1_hiera_b+.yaml
PLANTGUARD_UNCERTAINTY_THRESHOLD=0.65
PLANTGUARD_MIN_CLASSIFICATION_CONFIDENCE=0.40
PLANTGUARD_SEVERITY_LOW_THRESHOLD_PCT=15
PLANTGUARD_SEVERITY_MEDIUM_THRESHOLD_PCT=35

# Runtime profile. `auto` preserves local device discovery; `remote` is opt-in.
PLANTGUARD_INFERENCE_PROFILE=auto
PLANTGUARD_CPU_MEMORY_LIMIT_GB=
PLANTGUARD_CUDA_MEMORY_LIMIT_GB=
PLANTGUARD_MAX_CONCURRENCY=1

# Remote inference is disabled unless both HTTPS URL and bearer token are configured
# and PLANTGUARD_INFERENCE_PROFILE=remote. Never place real tokens in this example.
PLANTGUARD_REMOTE_INFERENCE_URL=
PLANTGUARD_REMOTE_INFERENCE_TOKEN=
PLANTGUARD_REMOTE_IMAGE_UPLOAD_AUTHORIZED=false
PLANTGUARD_REMOTE_MAX_IMAGE_BYTES=10485760
PLANTGUARD_REMOTE_TIMEOUT_SECONDS=60
PLANTGUARD_REMOTE_MAX_CONCURRENCY=1

# Optional runtime diagnostics bearer token. Do not expose it in logs or responses.
PLANTGUARD_DIAGNOSTICS_TOKEN=
