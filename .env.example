# Application Configuration
APP_NAME=PlantGuard AI
APP_VERSION=0.1.0
DEBUG=False

# API
API_V1_STR=/api
PROJECT_NAME=PlantGuard AI

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=960  # 8 days (60 * 24 * 8)

# Database
DATABASE_URL=sqlite:///./plantguard.db  # For development: sqlite:///./plantguard.db
# For PostgreSQL: postgresql://user:password@postgres:5432/plantguard

# ML Model Settings
ML_MODEL_PATH=./ml-models  # Base path for model artifacts
ML_MODE=mock  # "mock" or "real" - controls whether to use mock or real ML models

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10 MB
UPLOAD_FOLDER=./uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Object Storage Settings
STORAGE_PROVIDER=mock  # "mock", "s3", "minio", etc.
STORAGE_BUCKET=plantguard-ai  # Bucket/container name
STORAGE_REGION=us-east-1  # Storage region
STORAGE_ENDPOINT=  # Custom endpoint (for MinIO, etc.) - empty for AWS
STORAGE_ACCESS_KEY=  # Access key (empty for mock/IAM roles)
STORAGE_SECRET_KEY=  # Secret key (empty for mock/IAM roles)
STORAGE_PRESIGNED_URL_EXPIRY=3600  # Expiry time for signed URLs (seconds)
MAX_IMAGE_SIZE=10485760  # 10 MB
MAX_VIDEO_SIZE=52428800  # 50 MB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo

# CORS
BACKEND_CORS_ORIGINS=*