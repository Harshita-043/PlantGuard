# Backend settings. Canonical backend template: backend/.env.example.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plantguard

# Select explicitly. The application defaults to no storage provider.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local-storage

# Cloudflare R2 S3 API settings. Required only with OBJECT_STORAGE_PROVIDER=r2.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase Storage S3 API settings. Required only with OBJECT_STORAGE_PROVIDER=supabase.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

# Authentication: generate a unique random secret for backend/.env.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional provider settings. Agentic API requests are currently disabled.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
