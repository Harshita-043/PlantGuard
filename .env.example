# Backend settings. Copy to backend/.env for local backend runs.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plantguard

# Optional provider settings. Agentic API requests are currently disabled.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
